# Cloud providers in failover priority order
PROVIDERS=verda,modal

# Verda serverless container (vLLM + Nemotron 3.5 Lightning on 1x H100)
VERDA_LABEL=Verda
VERDA_BASE_URL=https://containers.datacrunch.io/hybridedge-nemotron/v1
VERDA_API_KEY=
VERDA_MODEL=nemotron-lightning
VERDA_HARDWARE=H100 SXM5

# Modal (deploy/modal_app.py) - cold standby, woken only when Verda is down
MODAL_LABEL=Modal
MODAL_BASE_URL=
MODAL_API_KEY=
MODAL_MODEL=nemotron-lightning
MODAL_HARDWARE=H100
MODAL_STANDBY=true

CLOUD_THINKING=true
CLOUD_MAX_AGENTS=5
EDGE_MAX_AGENTS=2

# Local Ollama (OpenAI-compatible)
EDGE_BASE_URL=http://127.0.0.1:11434/v1
EDGE_MODEL=hybridedge-bolt
